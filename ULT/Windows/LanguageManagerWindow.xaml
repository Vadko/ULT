<Window x:Class="ULT.LanguageManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування мовами" SizeToContent="Height" Width="400" ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="5,0,5,5">
        <StackPanel>
            <GroupBox Header="Додавання" Margin="0,0,0,6">
                <StackPanel Margin="2">
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameInput" Grid.Row="0" Grid.Column="1" Text="Ukrainian" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Code:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBox x:Name="CodeInput" Grid.Row="1" Grid.Column="1" Text="uk" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Flags:" VerticalAlignment="Center"/>
                        <TextBox x:Name="FlagsInput" Grid.Row="2" Grid.Column="1" Text="0" VerticalContentAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="AddHintLabel" Margin="0,2,4,4" TextWrapping="Wrap"/>
                    <Button x:Name="BtnAdd" Content="Додати нову мову" HorizontalAlignment="Right" Height="25" Width="125" Click="BtnAdd_Click" IsEnabled="False"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="0,0,0,6">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Видалення"/>
                    </StackPanel>
                </GroupBox.Header>
                <StackPanel Margin="2">
                    <ListBox x:Name="LanguagesListBox" Height="130" Margin="0,4,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" FontWeight="SemiBold"
                                          Checked="DeleteCheckBox_Changed" Unchecked="DeleteCheckBox_Changed"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Margin="0,2,0,2">
                        <TextBlock x:Name="DeleteCountLabel" Text="" FontStyle="Italic" FontSize="11" Foreground="red" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRemove" Content="Видалити позначені" HorizontalAlignment="Right" DockPanel.Dock="Right" Height="25" Width="125"
                                Click="BtnRemove_Click" IsEnabled="False"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
            <TextBlock x:Name="StatusLabel" Foreground="#2196F3" Margin="2,0,2,6" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
