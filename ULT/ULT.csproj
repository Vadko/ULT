<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>

	  <AssemblyTitle>ULT</AssemblyTitle>
	  <AssemblyDescription>Інструмент для редагування MonoBehaviour файлів локалізацій Unity.</AssemblyDescription>
	  <Company>Hikaro</Company>
	  <Product>ULT</Product>
	  <Copyright>© Hikaro 2026</Copyright>
	  <Version>1.0.4</Version>
	  <FileVersion>1.0.4</FileVersion>
	  <AssemblyVersion>1.0.4</AssemblyVersion>
	  <Authors>Hikaro</Authors>
	  <AssemblyName>ULT</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="donate_qr.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" />
    <Resource Include="donate_qr.png" />
  </ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="System.Security.Cryptography.ProtectedData" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

</Project>
